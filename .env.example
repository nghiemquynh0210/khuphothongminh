# ===========================================================
# KP3 An Phú — Environment Variables Template
# Sao chép file này thành .env.local và điền giá trị thực
# KHÔNG bao giờ commit .env.local vào Git!
# ===========================================================

# ---- Gemini AI ----
# Required for Gemini AI API calls (AI Assistant trong app)
GEMINI_API_KEY="your_gemini_api_key_here"

# ---- App URL ----
# URL ứng dụng (tự động inject bởi AI Studio)
APP_URL="http://localhost:3000"

# ---- Google Maps ----
# Required for Google Maps Platform integrations
GOOGLE_MAPS_PLATFORM_KEY=your_google_maps_key

# ---- Supabase ----
# Required for cloud database persistence & Supabase MCP
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- MCP Servers (Secrets — dùng trong .agents/mcp_config.json) ----
# Supabase Service Account Access Token
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_access_token

# Vercel Personal Access Token
VERCEL_API_TOKEN=vcp_your_vercel_personal_access_token

# GitHub Personal Access Token (cho GitHub MCP — Công cụ #14)
GITHUB_PAT=ghp_your_github_personal_access_token

# Firecrawl API Key (cho Firecrawl MCP — Công cụ #17)
FIRECRAWL_API_KEY=your_firecrawl_api_key
