{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "wjdgaobhipkgzveidtra"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-vercel"
      ],
      "env": {
        "VERCEL_API_TOKEN": "${VERCEL_API_TOKEN}"
      }
    },
    "notebooklm": {
      "command": "npx",
      "args": [
        "-y",
        "@m4ykeldev/notebooklm-mcp",
        "serve"
      ]
    },
    "office": {
      "command": "npx",
      "args": [
        "-y",
        "office-mcp"
      ],
      "env": {
        "DOTNET_ROLL_FORWARD": "LatestMajor"
      }
    },
    "excel": {
      "command": "python",
      "args": [
        "-m",
        "excelmcp.server"
      ],
      "env": {
        "EXCEL_ENABLE_WRITE": "true"
      }
    },
    "powerpoint": {
      "command": "python",
      "args": [
        "-m",
        "pptmcp.server"
      ],
      "env": {
        "PPT_ENABLE_WRITE": "true"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
      }
    }
  }
}
